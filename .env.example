# ============================================================
#  KGP Crew Monitoring System — Required Environment Variables
#  Copy this file to .env and fill in REAL values before deploy.
#  ⚠️  .env must NEVER be committed to version control.
# ============================================================

# --- Flask / Security ---
# REQUIRED. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_A_STRONG_RANDOM_HEX_VALUE

# Shared secret between webapp and scraper — MUST match in both.
# Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET

# --- Flask Runtime Mode ---
# Set to "production" to enable HTTPS-only cookies and disable Flask debug.
FLASK_ENV=production

# --- Database ---
# Absolute path to SQLite file. Default: <project_root>/data/crew.db
DB_PATH=/home/ubuntu/cms/data/crew.db

# --- Network ---
# Port gunicorn listens on (nginx/Coolify proxies from 80 to this port).
PORT=8080

# --- First-run Admin Bootstrap ---
# Only used when the users table is empty (first deployment).
# After the super-admin is created these are ignored.
BOOTSTRAP_ADMIN_USERNAME=REPLACE_WITH_ADMIN_USERNAME
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_MIN_8_CHARS

# --- CMS & RTIS Portal Credentials ---
# ⚠️  IMPORTANT: CMS and RTIS credentials are NOT managed via environment variables.
# After deployment, log in as admin and navigate to Admin → Settings to enter:
#   - CMS Username / CMS Password
#   - RTIS Username / RTIS Password
#
# This is intentional because Indian Railways forces credential rotation every 6 months
# and requires a daily OTP — credentials must be updatable via the admin UI without
# redeployment. See DEPLOYMENT_CHECKLIST.md "Credential Rotation Procedures" for details.

# --- Google Cloud Vision API (for CAPTCHA solving) ---
# Provide one or more service-account JSON files base64-encoded.
# Encode:  base64 -w0 /path/to/service-account.json
# Numbered variants (GCP_CREDENTIALS_B64_1, _2, ...) enable daily rotation.
# GCP_CREDENTIALS_B64_1=<base64-encoded-json-for-account-1>
# GCP_CREDENTIALS_B64_2=<base64-encoded-json-for-account-2>
#
# If only one account: use the unnumbered form.
# GCP_CREDENTIALS_B64=<base64-encoded-json>
#
# If no GCP credentials are set, Google Vision OCR is unavailable and
# CAPTCHA solving falls back to ddddocr (local) or manual admin entry.
